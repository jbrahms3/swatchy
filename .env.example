# Copy to .env and fill in for local development.
# Both are safe to expose client-side (EXPO_PUBLIC_* is baked into the JS
# bundle) — the Clerk key here is the *publishable* key, not the secret one.

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_API_URL=https://swatchy-api-production.up.railway.app

# Required as of SDK 56 — the new default global fetch (expo/fetch) rejects
# React Native's native FormData part shape, which store.ts's appendPhoto()
# relies on for every photo upload (claiming, weekly, artwork). Remove this
# once that code is migrated to a WinterTC-compliant upload path.
EXPO_PUBLIC_USE_RN_FETCH=1
