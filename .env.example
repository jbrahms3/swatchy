# Copy to .env and fill in for local development.
# Both are safe to expose client-side (EXPO_PUBLIC_* is baked into the JS
# bundle) — the Clerk key here is the *publishable* key, not the secret one.

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_API_URL=https://swatchy-api-production.up.railway.app
