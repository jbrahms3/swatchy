{
  "expo": {
    "name": "Swatchy",
    "slug": "colorclaim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "colorclaim",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0F",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDF9F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Swatchy needs access to your photos so you can pick colors out of them.",
          "cameraPermission": "Swatchy uses the camera so you can claim colors from a photo you take."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Swatchy uses the camera so you can photograph a match for the weekly color challenge.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
